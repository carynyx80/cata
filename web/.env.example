# backend + site
NEXT_PUBLIC_API_URL=https://api.catapacks.xyz
NEXT_PUBLIC_SITE_URL=https://catapacks.xyz
# optional: enables the WalletConnect option in the connect modal
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# optional: custom BSC RPC (public dataseed/publicnode are used as fallbacks)
NEXT_PUBLIC_BSC_RPC_URL=
# optional: first block to scan for vault Transfer logs (vault deploy block)
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=

# BNB Chain (56) contract addresses — leave empty until deployed; the UI shows "contracts launching soon"
NEXT_PUBLIC_CATA_CONFIG=
NEXT_PUBLIC_PACK_MACHINE=
NEXT_PUBLIC_CATA_VAULT=
NEXT_PUBLIC_CATA_MARKET=
NEXT_PUBLIC_GIFT_PACKS=
NEXT_PUBLIC_CATA_POINTS=
NEXT_PUBLIC_SET_REWARDS=
NEXT_PUBLIC_PRICE_INDEX=
NEXT_PUBLIC_PREDICTION_MARKET=
NEXT_PUBLIC_CARD_LENDING=
NEXT_PUBLIC_LIVE_RIPS=
NEXT_PUBLIC_PACK_BATTLES=
NEXT_PUBLIC_FRACTIONAL_GRAILS=
NEXT_PUBLIC_CATA_TREASURY=
