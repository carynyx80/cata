# Server
PORT=8787
CORS_ORIGIN=http://localhost:3000
DATA_DIR=./data

# Admin token for live-rip CRUD (send as header x-admin-token)
ADMIN_TOKEN=

# AI card scan (Claude vision). Without it POST /scan returns 503.
ANTHROPIC_API_KEY=

# Chain (BSC mainnet)
RPC_URL=https://bsc-dataseed.binance.org
# Oracle key for pushing prices to CataPriceIndex. Without it pushPrices is dry-run only.
ORACLE_PRIVATE_KEY=

# Contract addresses (leave blank if not deployed; backend falls back to local/seed data)
CATA_CONFIG_ADDRESS=
CATA_VAULT_ADDRESS=
# Block CataVault was deployed at (holdings are rebuilt from Transfer logs; vault is not ERC721Enumerable)
VAULT_DEPLOY_BLOCK=0
VAULT_LOG_CHUNK=5000
PACK_MACHINE_ADDRESS=
MARKETPLACE_ADDRESS=
CATA_TREASURY_ADDRESS=
CATA_PRICE_INDEX_ADDRESS=
CATA_POINTS_ADDRESS=
LIVE_RIPS_ADDRESS=
LENDING_ADDRESS=
GIFT_PACKS_ADDRESS=
PREDICTION_MARKETS_ADDRESS=

# $CATA token address. Empty = not active ("$CATA coming soon"). Ignored if CataConfig on chain is configured.
CATA_TOKEN=

# Feature flags (off by default)
FEATURE_PACK_BATTLES=false
FEATURE_FRACTIONAL=false
FEATURE_PREDICTIONS=false
